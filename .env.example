# ══════════════════════════════════════════════════════
# VisionCare AI — Backend — Variables de entorno
# Copiar este archivo como ".env" y completar valores
# ══════════════════════════════════════════════════════

# ─── Aplicación ───
APP_NAME="VisionCare AI API"
NODE_ENV=development            # development | production
PORT=3000
API_PREFIX=api/v1

# ─── Base de datos PostgreSQL ───
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD= alison123
DB_DATABASE=visioncare_db
DB_SSL=false                    # true solo si el servidor exige SSL (prod)
DB_SYNCHRONIZE=true             # true SOLO en desarrollo (crea tablas solo)
DB_LOGGING=true                 # muestra SQL en consola
DB_MAX_POOL=10                  # conexiones máximas del pool

# ─── Autenticación JWT ───
JWT_SECRET=7b60005ae5d7d219ffc3dfd05c7247daba2b255366e3fd10abb9edf151d6f8e11814b1ad536d7a5a
8918e73e259ba170
JWT_EXPIRES_IN=8h               # duración del token
JWT_ISSUER=visioncare-ai

# ─── Cloudflare R2 (almacenamiento de imágenes) ───
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key
R2_BUCKET=visioncare-archivos
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev   # dominio público del bucket
R2_SIGNED_URL_TTL=900           # segundos de validez de URLs firmadas

# ─── Servicio de IA (FastAPI) ───
IA_SERVICE_URL=http://localhost:8000/api/v1
IA_SERVICE_TIMEOUT_MS=30000     # timeout de llamadas a YOLO/OCR (ms)

# ─── CORS (orígenes permitidos) ───
CORS_ORIGINS=http://localhost:5173

# ─── Rate limiting (protección) ───
THROTTLE_TTL_MS=60000           # ventana en ms
THROTTLE_LIMIT=100              # peticiones por ventana por IP

# ─── Swagger (documentación) ───
SWAGGER_ENABLED=true            # false en producción

# ─── API Key compartida con el servicio IA ───
# Si se define en ambos lados, NestJS la envía como X-API-Key
IA_API_KEY=