# ══════════════════════════════════════════════════════════════════════════════
# VisionCare AI — Backend (NestJS) — Plantilla de Variables de Entorno (.env.example)
#
# ⚠️ ADVERTENCIA DE SEGURIDAD:
#    - NUNCA subas tu archivo ".env" real a GitHub ni compartas contraseñas en Git.
#    - Este archivo viene configurado POR DEFECTO PARA DESARROLLO LOCAL.
#    - Lee los comentarios de cada sección para saber qué cambiar al desplegar en PRODUCCIÓN.
# ══════════════════════════════════════════════════════════════════════════════

# ─── 1. Aplicación ───
APP_NAME="VisionCare AI API"
PORT=3000
API_PREFIX=api/v1

# 💻 POR DEFECTO (Desarrollo local): development
# 🚀 EN PRODUCCIÓN: Cambiar a production
NODE_ENV=development

# ─── 2. Base de datos PostgreSQL ───
# 💻 POR DEFECTO (Desarrollo local con PostgreSQL en PC / Docker local):
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=cambiar_por_tu_password_local
DB_DATABASE=visioncare_db
DB_SSL=false                      # false en local | 🚀 Cambiar a true OBLIGATORIO en producción (servidores en la nube)
DB_SYNCHRONIZE=true              # true en desarrollo para crear/actualizar tablas | ⚠️ Cambiar a false OBLIGATORIO en producción
DB_LOGGING=true                  # true para ver consultas SQL en consola | 🚀 Cambiar a false en producción
DB_MAX_POOL=10                   # conexiones máximas del pool

# 🚀 NOTA PARA PRODUCCIÓN (Railway, Supabase, Neon, etc.):
#   - DB_HOST: provisto por tu hosting (ej. roundhouse.proxy.rlwy.net)
#   - DB_SSL=true (las bases de datos en la nube rechazan conexiones sin SSL)
#   - DB_SYNCHRONIZE=false (evita alterar o borrar tablas con datos reales)
#   - DB_LOGGING=false (optimiza el rendimiento)

# ─── 3. Autenticación JWT ───
# En producción: generar una cadena secreta segura de al menos 32 caracteres aleatorios
JWT_SECRET=REEMPLAZAR_CON_SECRETO_LARGO_Y_ALEATORIO_MINIMO_32_CARACTERES
JWT_EXPIRES_IN=8h                # duración del token
JWT_ISSUER=visioncare-ai

# ─── 4. Cloudflare R2 (Almacenamiento S3 de imágenes) ───
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key
R2_BUCKET=visioncare-archivos
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev   # dominio público del bucket
R2_SIGNED_URL_TTL=900            # segundos de validez de URLs firmadas

# ─── 5. Servicio de IA (FastAPI) ───
# 💻 POR DEFECTO (Local): http://localhost:8000/api/v1
# 🚀 EN PRODUCCIÓN: URL HTTPS pública de tu microservicio de IA desplegado
IA_SERVICE_URL=http://localhost:8000/api/v1
IA_SERVICE_TIMEOUT_MS=30000      # timeout de llamadas a YOLO/OCR (ms)
IA_API_KEY=                      # Si se define en ambos lados, NestJS la envía como X-API-Key

# ─── 6. CORS (Orígenes permitidos) ───
# "*" permite tanto la web como las peticiones desde la app móvil en desarrollo y producción
CORS_ORIGINS=*

# ─── 7. Rate Limiting (Protección contra ataques) ───
THROTTLE_TTL_MS=60000            # ventana en ms (1 minuto)
THROTTLE_LIMIT=100               # peticiones máximas por ventana por IP

# ─── 8. Swagger (Documentación interactiva de la API) ───
# 💻 true en desarrollo para consultar http://localhost:3000/docs
# 🚀 false en producción estricta si deseas ocultar la documentación pública
SWAGGER_ENABLED=true

# ─── 9. Autenticación Social (OAuth 2.0) ───
# ID de cliente tipo "Aplicación web" obtenido en Google Cloud Console
GOOGLE_CLIENT_ID=tu_cliente_id_web_de_google.apps.googleusercontent.com
FACEBOOK_APP_ID=tu_facebook_app_id
FACEBOOK_CLIENT_TOKEN=tu_facebook_client_token
